/*
 * BThome PIR overlay for Seeed XIAO nRF52840 Sense
 *
 * IMU            : LSM6DS3TR-C (internal) on i2c0 — SDA = P0.07, SCL = P0.27.
 *                  Device node is already defined in xiao_ble_nrf52840_sense.dts.
 * PIR            : P0.02 (XIAO pin D0), active-high, pull-down.
 * BLE Tx indicator: P0.05 (XIAO pin D5 / i2c1 SCL).
 *                   i2c1 is disabled to free P0.05 as GPIO.
 */
/ {
	pir_inputs: pir_inputs {
		compatible = "gpio-keys";
		pir0: pir_0 {
			gpios = <&gpio0 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
			label = "PIR Sensor";
		};
	};

	/* P0.05 (D5): HIGH during BLE Tx, LOW otherwise.
	 * i2c1 (P0.04=SDA, P0.05=SCL) must be disabled to use this pin as GPIO. */
	active_ind: active_indicator {
		compatible = "gpio-leds";
		active0: active_0 {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			label = "BLE Tx Indicator";
		};
	};

	aliases {
		imu              = &lsm6ds3tr_c;
		pir-sensor       = &pir0;
		active-indicator = &active0;
	};
};

/* Disable i2c1 (P0.04=SDA, P0.05=SCL) to free P0.05 as GPIO. */
&i2c1 {
	status = "disabled";
};
